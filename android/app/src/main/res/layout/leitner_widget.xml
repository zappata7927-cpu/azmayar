<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/w_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="جعبه لایتنر"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_chip"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- question -->
    <TextView
        android:id="@+id/w_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="right"
        android:maxLines="6"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp" />

    <!-- answer (hidden until flipped) -->
    <TextView
        android:id="@+id/w_answer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:ellipsize="end"
        android:gravity="right"
        android:maxLines="5"
        android:textColor="#E7FBF6"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:background="@drawable/widget_answer_box"
        android:padding="8dp" />

    <!-- actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_btn_flip"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="نمایش پاسخ"
            android:textColor="#0B4640"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_btn_good"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:visibility="gone"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_good"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="بلدم"
            android:textColor="#14532D"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_btn_bad"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:visibility="gone"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_bad"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="نمی‌دانم"
            android:textColor="#7F1D1D"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- done state -->
    <TextView
        android:id="@+id/w_done_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        android:text="برای دیدن کارت‌های بعدی، فردا سر بزنید."
        android:textColor="#D6F4EE"
        android:textSize="11sp" />

    <!-- footer -->
    <TextView
        android:id="@+id/w_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#B8E8E0"
        android:textSize="10sp" />
</LinearLayout>
